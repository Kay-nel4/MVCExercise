@model Product

<h2>@Model.Name Information</h2>

<table class="table">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Price</th>
        <th>Category ID</th>
        <th>Sale</th>
        <th>Stock</th>
    </tr>
    
    <tr>
        <td>@Model.CategoryId</td>
        <td>@Model.Name</td>
        <td>@Model.Price</td>
        <td>@Model.CategoryId</td>
        <td>@Model.OnSale</td>
        <td>@Model.StockLevel</td>
    </tr>

</table>